---
import App from "../layouts/App.astro";
import Sidebar from "../components/shell/Sidebar.jsx";
import Header from "../components/shell/Header.jsx";
import Footer from "../components/shell/Footer.jsx";
import Toasts from "../components/shell/Toasts.jsx";
import Modal from "../components/shell/Modal.jsx";
import Sections from "../components/Sections.astro";
---

<App>
  <div class="shell">
    <Sidebar client:only="preact" />

    <main class="content">
      <Header client:only="preact" />

<div id="checkupPage" class="content-grid">


        <!-- ===================================
             INTERACTIVE ASTRONAUT
        ==================================== -->

        <section class="twin-card">

          <div class="twin-header">

            <div>

              <h2 class="daily-checkup-title">
                Daily Checkup
              </h2>

              <small id="modeText">
                Suit view · Click to open
              </small>

            </div>

          </div>


          <!-- ASTRONAUT VISUALIZATION -->

          <div class="figure-scene">

            <div class="glow"></div>


            <!-- MISSION INFORMATION -->

            <div
              class="astronaut-mission-info"
              aria-label="Demo mission information"
            >

              <div class="astronaut-mission-line">

                <span class="astronaut-status-dot"></span>

                <span>Mission Day 127 / 365</span>

              </div>

              <div class="astronaut-mission-line">

                <span aria-hidden="true">👩🏻‍🚀</span>

                <span>Solange · Demo Astronaut</span>

              </div>

            </div>


            <!-- ASTRONAUT BODY -->

            <div
              id="figureWrap"
              class="figure-wrap"
              tabindex="0"
              role="button"
              aria-label="Open astronaut spacesuit to see body"
              title="Click to open the suit"
            >


              <!-- ORGAN OVERLAY -->

              <div
                id="astronautOrganOverlay"
                class="astronaut-organ-overlay"
                hidden
              >

                <img
                  id="astronautOrganImage"
                  src="assets/heart.png"
                  alt="Selected anatomical organ"
                >

              </div>


              <!-- BODY HOTSPOTS -->

              <!-- BRAIN -->

              <button
                type="button"
                class="hotspot"
                data-part="brain"
                aria-label="Brain and sleep"
              ></button>

              <span class="hotspot-label label-brain">
                Brain
              </span>


              <!-- HEART -->

              <button
                type="button"
                class="hotspot"
                data-part="heart"
                aria-label="Heart"
              ></button>

              <span class="hotspot-label label-heart">
                Heart
              </span>


              <!-- LUNGS -->

              <button
                type="button"
                class="hotspot"
                data-part="lungs"
                aria-label="Lungs"
              ></button>

              <span class="hotspot-label label-lungs">
                Lungs
              </span>


              <!-- KIDNEYS -->

              <button
                type="button"
                class="hotspot"
                data-part="kidneys"
                aria-label="Kidneys and urinary health"
              ></button>

              <span class="hotspot-label label-kidneys">
                Kidneys
              </span>


              <!-- PULSE -->

              <button
                type="button"
                class="hotspot"
                data-part="hand"
                aria-label="Temperature and glucose"
              ></button>

              <span class="hotspot-label label-hand">
                Temp &amp; glucose
              </span>


              <!-- BONES -->

              <button
                type="button"
                class="hotspot"
                data-part="bones"
                aria-label="Bones"
              ></button>

              <span class="hotspot-label label-bones">
                Bones
              </span>


              <!-- MUSCLES -->

              <button
                type="button"
                class="hotspot"
                data-part="muscles"
                aria-label="Muscles"
              ></button>

              <span class="hotspot-label label-muscles">
                Muscles
              </span>

            </div>


            <!-- OPEN / CLOSE SUIT -->

            <button
              type="button"
              class="action-bubble"
              id="suitButton"
            >
              ✦ Open spacesuit
            </button>

          </div>


          <div class="figure-helper">
            Click astronaut to open · Select a body system
          </div>

        </section>


        <!-- ===================================
             HEALTH DATA PANEL
        ==================================== -->

        <section class="card detail-card">


          <!-- HEALTH SYSTEM HEADER -->

          <div class="detail-header">

            <div
              id="detailIcon"
              class="detail-icon"
            >
              ♥
            </div>

            <div>

              <h2 id="detailTitle">
                Cardiovascular System
              </h2>

              <p id="detailSubtitle">
                Heart rate · Blood pressure · HRV
              </p>

            </div>

            <span class="demo-badge">
              Demo values
            </span>

          </div>


          <!-- =================================
               DAILY HEALTH CHECK
          ================================== -->

          <section class="daily-check-layout">


            <!-- LEFT: ANATOMY -->

            <div class="daily-organ-panel">

              <p class="daily-section-label">
                SELECTED ANATOMY
              </p>

              <div
                id="organImageBox"
                class="organ-visual"
              >

                <img
                  id="organImage"
                  src="assets/heart.png"
                  alt="Selected anatomical organ"
                >

              </div>

            </div>


            <!-- RIGHT: MEASUREMENTS -->

            <div class="record-editor daily-record-panel">

              <div class="editor-head">

                <div>
                  <strong>
                    Today's measurements
                  </strong>
                </div>

              </div>


              <!-- DYNAMIC INPUT FIELDS -->

              <div
                id="inputFields"
                class="input-row"
              ></div>


              <!-- BUTTONS -->

              <div class="buttons-row">

                <button
                  type="button"
                  class="btn btn-primary"
                  id="saveData"
                >
                  Save measurements
                </button>

                <button
                  type="button"
                  class="btn btn-soft"
                  id="sampleData"
                >
                  Demo values
                </button>

              </div>

            </div>

          </section>


          <!-- =================================
               FULL-WIDTH HEALTH INDICATORS
          ================================== -->

          <section
            id="healthStatusPanel"
            class="health-status-panel"
          >

            <h3>Health indicators</h3>

            <div
              id="healthStatusBars"
              class="health-status-bars"
            ></div>

          </section>


          <!-- HIDDEN ELEMENTS REQUIRED BY JS -->

          <div
            id="metricCards"
            class="metric-cards"
            hidden
          ></div>

          <div class="chart-card" hidden>

            <div class="chart-head">

              <strong id="chartTitle">
                Health Trend
              </strong>

            </div>

            <svg
              id="trendChart"
              class="chart-svg"
              viewBox="0 0 520 159"
              preserveAspectRatio="none"
            ></svg>

          </div>


          <!-- HIDDEN CLINICAL CONTEXT -->

          <p id="insightText" hidden></p>

        </section>
        <!-- END HEALTH DATA PANEL -->


      </div>
      <!-- END checkupPage -->


      <!-- =====================================
           PAGE 2 — EXERCISE & RECOVERY
           IMPORTANT: OUTSIDE checkupPage
      ====================================== -->

      <section
        id="exercisePage"
        class="exercise-page"
        hidden
      >

        <div class="exercise-heading">

          <h2>Exercise & Recovery</h2>

          <p>
            Which type of exercise would you
            like to log today?
          </p>

        </div>


        <!-- EXERCISE CARDS -->

        <div class="exercise-options">


          <!-- ARED -->

          <button
            type="button"
            class="exercise-option"
            data-exercise="ared"
          >

            <img
              src="assets/ARED.png"
              alt="Astronaut performing resistance training"
              class="exercise-card-image"
            >

            <h3>ARED</h3>

            <p>Resistance Training</p>

          </button>


          <!-- T2 -->

          <button
            type="button"
            class="exercise-option"
            data-exercise="t2"
          >

            <img
              src="assets/T2.png"
              alt="Astronaut running on a treadmill"
              class="exercise-card-image"
            >

            <h3>T2</h3>

            <p>Treadmill Running</p>

          </button>


          <!-- CEVIS -->

          <button
            type="button"
            class="exercise-option"
            data-exercise="cevis"
          >

            <img
              src="assets/CEVIS.png"
              alt="Astronaut using the cycling system"
              class="exercise-card-image"
            >

            <h3>CEVIS</h3>

            <p>Cycling Training</p>

          </button>

        </div>


        <!-- SAVE CONFIRMATION -->

        <p
          id="exerciseSaveStatus"
          class="exercise-save-status"
          role="status"
          aria-live="polite"
        ></p>

      </section>
      <!-- END exercisePage -->

      <Sections />

      <Footer client:only="preact" />
    </main>
  </div>

  <Toasts client:only="preact" />
  <Modal client:only="preact" />
</App>
